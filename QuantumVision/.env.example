# QuantumVision System Configuration Template
# Andhra Pradesh Intelligent Disaster Navigation & Emergency Management

# Environment Mode
ENVIRONMENT=development
DEBUG=True

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api
PROJECT_NAME="QuantumVision: Intelligent Disaster Navigation and Emergency Evacuation Management"
PROJECT_VERSION="1.0.0"

# Secret Key for JWT & Security
SECRET_KEY=quantumvision_super_secret_development_key_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Database
DATABASE_URL=sqlite:///./backend/quantumvision.db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Geographic Focus - Andhra Pradesh Bounding Box
AP_BOUNDS_MIN_LAT=12.6
AP_BOUNDS_MAX_LAT=19.9
AP_BOUNDS_MIN_LON=76.7
AP_BOUNDS_MAX_LON=84.8
AP_DEFAULT_LAT=16.5062
AP_DEFAULT_LON=80.6480

# Paths (Relative to project root or absolute)
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_FEATURES_DIR=data/features
DATA_UPLOADS_DIR=data/raw/uploads
ML_MODELS_DIR=ml/models

# Quantum Simulation Backend (simulated_annealing, qubo_classical, mock_qpu)
QUANTUM_BACKEND=simulated_annealing
NUM_QUBITS=16
QUANTUM_TIMEOUT_MS=5000

# External API Keys (Optional)
NASA_FIRMS_MAP_KEY=
OPENWEATHER_API_KEY=
CESIUM_ION_TOKEN=
